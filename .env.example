# Multimodal AI for Real-Time Disaster Intelligence - DisasterLens
# Environment Configuration Template

# OpenAI API Key (gpt-4o vision image classification & situational synthesis)
OPENAI_API_KEY=

# Groq API Key (llama-3.3-70b-versatile for summaries, llama-3.1-8b-instant for triage)
GROQ_API_KEY=

# CARTO Spatial API Key
CARTO_API_KEY=

# NASA FIRMS Map Key (For worldwide real-time wildfire thermal anomaly feeds)
# Get a free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# OpenWeatherMap One Call 3.0 API Key (Optional; system defaults to free Open-Meteo worldwide feed if empty)
OPENWEATHER_API_KEY=

# Sentinel Hub API Credentials (Optional; fallback to NASA Worldview / Open Street tiles)
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Twilio Multi-Channel Alerting (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=whatsapp:+14155238886

# Supabase Auth / Storage (Optional; local storage enabled by default)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Database Connection (PostgreSQL + PostGIS or default local SQLite)
# If left empty, SQLite with Spatial calculations (Haversine & GeoJSON) is automatically used.
DATABASE_URL=
